<Window x:Class="Domru.Desktop.CallWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:Domru.Desktop.Controls" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework" Icon="Assets/app.ico" Title="Звонок в домофон" Width="860" Height="730" MinWidth="700" MinHeight="580" WindowStyle="None" ResizeMode="CanResize" Background="#F5F6F9" Foreground="{StaticResource Ink}" FontFamily="Segoe UI" FontSize="14" WindowStartupLocation="CenterScreen" Topmost="True" Closing="OnClosing">
  <shell:WindowChrome.WindowChrome><shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0"/></shell:WindowChrome.WindowChrome>
  <Border BorderBrush="#E6CBD1" BorderThickness="1"><Grid><Grid.RowDefinitions><RowDefinition Height="48"/><RowDefinition Height="*"/></Grid.RowDefinitions><Border Background="White" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" MouseLeftButtonDown="TitleDrag"><Grid Margin="24,0,8,0"><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Ellipse Width="7" Height="7" Fill="{StaticResource Red}" VerticalAlignment="Center" Margin="0,0,9,0"/><TextBlock x:Name="CallHeader" Text="ВХОДЯЩИЙ ЗВОНОК" Foreground="{StaticResource Red}" FontSize="10" FontWeight="SemiBold"/></StackPanel><Button Style="{StaticResource Chrome}" Content="&#xE8BB;" Click="CloseWindowClick" HorizontalAlignment="Right"/></Grid></Border>
  <Grid Grid.Row="1" Margin="26,24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid Margin="0,0,0,20"><StackPanel><TextBlock x:Name="DoorTitle" FontSize="30" FontWeight="SemiBold"/><TextBlock x:Name="CallState" Text="Посетитель звонит в дверь" Foreground="{StaticResource Muted}" Margin="0,7,0,0"/></StackPanel><Border Background="#FDE8ED" CornerRadius="16" Padding="12,7" HorizontalAlignment="Right" VerticalAlignment="Center"><TextBlock x:Name="CallBadge" Text="ВИДЕОЗВОНОК" Foreground="{StaticResource Red}" FontSize="10" FontWeight="SemiBold"/></Border></Grid>
    <Border Grid.Row="1" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="18" Padding="10"><Grid><controls:VideoSurface x:Name="Video" Visibility="Hidden"/><Grid x:Name="CallEmptyState" Background="#FAF4F6" SizeChanged="RoundPlaceholder"><StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"><Border Background="#FBE0E7" Width="80" Height="80" CornerRadius="24" HorizontalAlignment="Center"><TextBlock Text="&#xE714;" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource Red}" FontSize="32" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock x:Name="Placeholder" Text="Подключаем камеру…" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,20,0,0"/><TextBlock Text="Вы увидите посетителя здесь" Foreground="{StaticResource Muted}" FontSize="12" HorizontalAlignment="Center" Margin="0,9,0,0"/></StackPanel></Grid></Grid></Border>
    <Border Grid.Row="2" Style="{StaticResource Card}" Padding="18" Margin="0,16,0,0"><StackPanel><UniformGrid Columns="3"><Button x:Name="AnswerButton" Style="{StaticResource Primary}" Content="Ответить" Click="AnswerClick" Margin="0,0,8,0" Padding="18,15"/><Button x:Name="OpenButton" Content="Открыть дверь" Click="OpenClick" Margin="0,0,8,0" Padding="18,15"/><Button Content="Завершить" Background="#FFF0F3" Foreground="{StaticResource Red}" BorderBrush="#F5CCD5" Click="HangupClick" Padding="18,15"/></UniformGrid><Button x:Name="RepeatMicrophoneButton" Content="Повторить проверку микрофона" Click="RepeatTestMicrophoneClick" Visibility="Collapsed" HorizontalAlignment="Center" Margin="0,14,0,0"/><CheckBox x:Name="MuteBox" Content="Отключить микрофон" Checked="MuteChanged" Unchecked="MuteChanged" HorizontalAlignment="Center" Margin="0,18,0,0"/></StackPanel></Border><StackPanel Grid.Row="3"><TextBlock x:Name="TestDoorStatus" Visibility="Collapsed" Foreground="#20804B" FontSize="12" TextWrapping="Wrap" Margin="0,12,0,0"/><StackPanel x:Name="MicrophoneDiagnostics" Visibility="Collapsed" Margin="0,12,0,0"><ProgressBar x:Name="CallMicrophoneLevel" Maximum="100" Height="6" Foreground="{StaticResource Red}"/><TextBlock x:Name="CallAudioStatus" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,6,0,0"/></StackPanel><TextBlock x:Name="ErrorLabel" Foreground="#BD2038" FontSize="12" TextWrapping="Wrap" Margin="0,12,0,0"/></StackPanel>
  </Grid></Grid></Border>
</Window>


