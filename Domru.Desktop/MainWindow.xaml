    <ListView x:Name="KeysList" Grid.Row="1" BorderThickness="0" Background="Transparent" Padding="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ItemContainerStyle="{StaticResource KeyCard}"><ListView.ItemTemplate><DataTemplate><Grid Margin="12,14"><Grid.ColumnDefinitions><ColumnDefinition Width="36"/><ColumnDefinition Width="*"/><ColumnDefinition Width="180"/></Grid.ColumnDefinitions><Image Width="24" Height="24" HorizontalAlignment="Left" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"><Image.Source><BitmapImage UriSource="/Assets/key-black.png" DecodePixelWidth="96"/></Image.Source></Image><StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,14,0"><TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="15" TextWrapping="Wrap"/><TextBlock Text="{Binding Doors}" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,5,0,0" TextWrapping="Wrap"><TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding Doors}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></StackPanel><TextBlock Grid.Column="2" Text="{Binding Code}" FontFamily="Consolas" FontSize="13" TextWrapping="Wrap" Margin="0,0,12,0" VerticalAlignment="Center"/></Grid></DataTemplate></ListView.ItemTemplate></ListView><TextBlock Grid.Row="1" x:Name="KeysEmptyText" Text="К этому адресу ключи не привязаны" Foreground="{StaticResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
  </Grid></Border>
</Grid>
<ScrollViewer x:Name="AccountPanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"><StackPanel>
  <Border x:Name="ProfileCard" Style="{StaticResource Card}" Padding="20"><StackPanel><TextBlock Text="Ваш аккаунт" FontSize="20" FontWeight="SemiBold"/><TextBlock x:Name="ProfileName" Margin="0,12,0,0" FontSize="16"/><TextBlock x:Name="ProfileContract" Margin="0,6,0,0" Foreground="{StaticResource Muted}"/><TextBlock x:Name="ProfileAddress" TextWrapping="Wrap" Margin="0,6,0,0"/></StackPanel></Border>
  <Border Style="{StaticResource Card}" Margin="0,12,0,0" Padding="20"><StackPanel><Grid><TextBlock x:Name="FinanceProvider" Text="Домофон" FontSize="20" FontWeight="SemiBold"/><Button Content="Обновить" Click="AccountRefreshClick" HorizontalAlignment="Right" Padding="12,8"/></Grid><UniformGrid Columns="2" Margin="0,16,0,0"><StackPanel><TextBlock Text="Баланс" Foreground="{StaticResource Muted}" FontSize="12"/><TextBlock x:Name="FinanceBalance" Text="Нет данных" FontSize="23" FontWeight="SemiBold" Margin="0,5,0,0"/></StackPanel><StackPanel><TextBlock Text="К оплате" Foreground="{StaticResource Muted}" FontSize="12"/><TextBlock x:Name="FinanceAmount" Text="Нет данных" FontSize="23" FontWeight="SemiBold" Margin="0,5,0,0"/></StackPanel></UniformGrid><TextBlock x:Name="FinanceDue" Margin="0,14,0,0"/><TextBlock x:Name="FinanceStatus" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,6,0,0"/><Button x:Name="AccountPayButton" Style="{StaticResource Primary}" Content="Оплатить по выбранному адресу" Click="AccountPayClick" IsEnabled="False" HorizontalAlignment="Left" Margin="0,16,0,0"/><TextBlock x:Name="AccountLoadStatus" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,10,0,0"/></StackPanel></Border>
  <Border Style="{StaticResource Card}" Margin="0,12,0,0" Padding="20"><StackPanel><TextBlock Text="Дом.ру" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="Личный кабинет и оплата услуг на официальном сайте" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,7,0,12"/><WrapPanel><Button Content="Личный кабинет" Tag="https://lk.dom.ru/" Click="ProviderLinkClick"/><Button Content="Оплатить Дом.ру" Tag="https://dom.ru/payments" Click="ProviderLinkClick" Margin="8,0,0,0"/></WrapPanel></StackPanel></Border>
  <Border Style="{StaticResource Card}" Margin="0,12,0,0" Padding="20"><StackPanel><TextBlock Text="Цифрал-Сервис" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="Личный кабинет и оплата домофона по лицевому счёту или адресу" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,7,0,12"/><WrapPanel><Button Content="Личный кабинет" Tag="https://lk.cyfral-group.ru/" Click="ProviderLinkClick"/><Button Content="Оплатить Цифрал-Сервис" Tag="https://pay.cyfral-group.ru/" Click="ProviderLinkClick" Margin="8,0,0,0"/></WrapPanel></StackPanel></Border>
</StackPanel></ScrollViewer>
<ScrollViewer x:Name="SettingsPanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"><StackPanel><Border Style="{StaticResource Card}" Margin="0,0,0,16"><StackPanel><TextBlock Text="Тестовый вызов" FontSize="22" FontWeight="SemiBold"/><TextBlock Text="Проверьте мелодию, окно входящего звонка, видео и звук." Style="{StaticResource Label}" TextWrapping="Wrap" Margin="0,8,0,18"/><Button x:Name="TestCallButton" Style="{StaticResource Primary}" Content="Тестовый вызов" Click="TestCallClick" HorizontalAlignment="Left" Padding="22,12"/><TextBlock Text="После появления окна нажмите «Ответить». Тест выполняется локально." Foreground="{StaticResource Muted}" FontSize="12" Margin="0,12,0,0"/></StackPanel></Border><Border Style="{StaticResource Card}" Margin="0,0,0,16"><StackPanel><TextBlock Text="Запуск и работа в фоне" FontSize="22" FontWeight="SemiBold"/><CheckBox x:Name="StartupBox" Content="Запускать вместе с Windows" IsChecked="False" Checked="StartupChanged" Unchecked="StartupChanged" Margin="0,20,0,0"/><TextBlock x:Name="StartupStatus" Text="Автозагрузка отключена" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,9,0,0"/><Border Height="1" Background="{StaticResource Line}" Margin="0,18"/><CheckBox x:Name="CloseToTrayBox" Content="При закрытии сворачивать в трей" IsChecked="True" Checked="CloseToTrayChanged" Unchecked="CloseToTrayChanged"/><TextBlock Text="Если включено, крестик скрывает окно, а приложение продолжает работать в фоне. Если выключено — завершает приложение." TextWrapping="Wrap" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,9,0,14"/><TextBlock Text="Кнопка сворачивания всегда отправляет приложение в трей. Двойной клик по значку возвращает окно." TextWrapping="Wrap" Foreground="{StaticResource Muted}" FontSize="12"/><TextBlock Text="Приём звонков продолжает работать, если он включён. Для полного завершения выберите «Выход» в меню значка." TextWrapping="Wrap" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,8,0,0"/></StackPanel></Border><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Звук звонка" FontSize="22" FontWeight="SemiBold"/><TextBlock Text="Выберите устройства для разговора с посетителем" Style="{StaticResource Label}" Margin="0,8,0,24"/><TextBlock Text="Микрофон" Style="{StaticResource Label}"/><ComboBox x:Name="MicrophoneBox" DisplayMemberPath="Label" SelectionChanged="AudioDeviceChanged"/><TextBlock Text="Динамики / наушники" Style="{StaticResource Label}" Margin="0,20,0,8"/><ComboBox x:Name="SpeakerBox" DisplayMemberPath="Label" SelectionChanged="AudioDeviceChanged"/><TextBlock Text="Микрофон включается при ответе на звонок или при запуске проверки." Foreground="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,22,0,0"/><Border Height="1" Background="{StaticResource Line}" Margin="0,20"/><WrapPanel><Button x:Name="MicrophoneTestButton" Content="Проверить микрофон" Click="CheckMicrophoneClick" Margin="0,0,10,10"/><Button x:Name="HeadphonesTestButton" Content="Проверить наушники" Click="CheckHeadphonesClick" Margin="0,0,10,10"/><Button Content="Остановить проверку" Click="StopAudioCheckClick" Margin="0,0,0,10"/></WrapPanel><ProgressBar x:Name="MicrophoneLevel" Height="7" Maximum="100" Foreground="{StaticResource Red}" Margin="0,4,0,12"/><TextBlock x:Name="AudioCheckStatus" Text="Проверка микрофона: говорите 4 секунды, затем прослушайте запись. Стереопроверка: левый канал, правый канал, затем оба канала." Foreground="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap"/></StackPanel></Border><Border Style="{StaticResource Card}" Margin="0,16,0,0"><StackPanel><TextBlock Text="Подключение" FontSize="22" FontWeight="SemiBold"/><TextBlock Text="Состояние каналов связи" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,8,0,0"/><StackPanel Margin="0,18,0,0"><TextBlock x:Name="ConnectionLabel" Text="Не выполнен вход" Margin="0,0,0,9"/><TextBlock x:Name="SipLabel" Text="SIP: выключен" Margin="0,0,0,9"/><TextBlock x:Name="PushLabel" Text="FCM: выключен"/></StackPanel></StackPanel></Border></StackPanel></ScrollViewer>
      </Grid></Grid>
    </Grid>
    <Border Grid.Row="3" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0"><Grid Margin="28,0"><TextBlock x:Name="StatusLabel" Text="Готово" Foreground="{StaticResource Muted}" FontSize="11" VerticalAlignment="Center" MaxWidth="1000" HorizontalAlignment="Left" TextTrimming="CharacterEllipsis"/><TextBlock Text="ДОМОФОН ПК  /  0.1.30" Foreground="#A1A7B2" FontSize="9" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid></Border>
